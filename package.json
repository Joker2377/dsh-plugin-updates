{
  "name": "dsh-plugin-updates",
  "version": "0.1.0",
  "description": "Read-only update intelligence for the agent: per-bundle latest version, engines.dsh gate verdict, and an install-ready spec, resolved from market indexes, npm registry, and git tags.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ],
  "author": "Joker2377",
  "license": "MIT",
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.1.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
